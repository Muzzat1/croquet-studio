{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gc-summer-temps",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "weather.croquetstudio.com/*",
      "zone_name": "croquetstudio.com"
    }
  ]
}